"""Forward verification to the Agent Framework submodule."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


def main() -> int:
    script = (
        Path(__file__).resolve().parent
        / "agent-framework"
        / "tools"
        / "run_verification.py"
    )
    if not script.is_file():
        print("Agent Framework is missing; initialize the agent-framework submodule.", file=sys.stderr)
        return 2
    return subprocess.run([sys.executable, str(script), *sys.argv[1:]], check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
